{
  "name": "@agent360/browser-mcp",
  "version": "1.29.2",
  "description": "Browser MCP - the browser tool that can stop and ask you. A 2FA code, a CAPTCHA, a choice only you can make: it asks on your own screen, then carries on in the tab you were already signed into. 40 tools, any MCP client, MIT.",
  "mcpName": "io.github.Agent360dk/browser-mcp",
  "type": "module",
  "main": "index.js",
  "bin": {
    "browser-mcp": "./bin/cli.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "vagt.js",
    "bin/",
    "extension/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test ../test/*.test.mjs",
    "flow": "node ../test/flow/run.mjs",
    "sessions": "node ../test/flow/sessions.mjs",
    "feedback": "node ../scripts/feedback-report.mjs",
    "start": "node index.js",
    "publish:cws": "../scripts/publish-cws.sh",
    "publish:cws:draft": "../scripts/publish-cws.sh --draft",
    "samtidighed": "node ../test/flow/samtidighed.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser",
    "browser-mcp",
    "browser-automation",
    "chrome",
    "chrome-extension",
    "claude",
    "claude-code",
    "ai-agent",
    "captcha",
    "captcha-solver",
    "human-in-the-loop",
    "web-automation",
    "playwright-alternative",
    "selenium-alternative"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Agent360",
    "email": "hello@agent360.dk",
    "url": "https://agent360.dk"
  },
  "license": "MIT",
  "homepage": "https://browsermcp.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Agent360dk/browser-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "hono": "^4.13.7",
    "ip-address": "^10.3.1",
    "@hono/node-server": "^1.19.15",
    "body-parser": "^2.2.3",
    "qs": "^6.16.0"
  }
